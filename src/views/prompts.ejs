<h1>Prompt Editor</h1>

<% if (typeof message !== 'undefined' && message) { %>
  <div class="alert alert-success"><%= message %></div>
<% } %>

<div class="tabs">
  <% for (const key of promptKeys) { %>
    <a href="/prompts?key=<%= key %>" class="tab <%= activeKey === key ? 'active' : '' %>"><%= key.replace(/_/g, ' ') %></a>
  <% } %>
</div>

<div style="display:grid; grid-template-columns: 1fr 300px; gap:1rem;">
  <div class="card">
    <h2>Edit: <%= activeKey.replace(/_/g, ' ') %></h2>
    <form action="/prompts" method="POST">
      <input type="hidden" name="key" value="<%= activeKey %>">
      <div class="field">
        <textarea name="content" rows="20"><%= activePrompt ? activePrompt.content : '[No prompt set — save to create one]' %></textarea>
      </div>
      <div class="field">
        <label for="notes">Save notes (optional)</label>
        <input type="text" name="notes" id="notes" placeholder="e.g., Updated tone for higher conversion">
      </div>
      <button type="submit" class="btn btn-primary">Save New Version</button>
      <% if (activePrompt) { %>
        <span class="text-muted" style="margin-left:0.5rem; font-size:0.8rem;">
          Currently: v<%= activePrompt.version %> — saved <%= new Date(activePrompt.created_at).toLocaleDateString('en-GB') %>
        </span>
      <% } %>
    </form>
  </div>

  <div class="card">
    <h2>Version History</h2>
    <% if (history.length === 0) { %>
      <p class="text-muted">No versions yet</p>
    <% } else { %>
      <% for (const h of history) { %>
        <div style="padding:0.5rem 0; border-bottom:1px solid #edf2f7;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <strong>v<%= h.version %></strong>
            <% if (h.is_active) { %>
              <span class="badge badge-green">Active</span>
            <% } else { %>
              <form action="/prompts/activate" method="POST" style="display:inline">
                <input type="hidden" name="id" value="<%= h.id %>">
                <input type="hidden" name="returnKey" value="<%= activeKey %>">
                <button type="submit" class="btn btn-sm" style="background:#edf2f7;">Activate</button>
              </form>
            <% } %>
          </div>
          <div class="text-muted" style="font-size:0.75rem;">
            <%= new Date(h.created_at).toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
            <% if (h.notes) { %> — <%= h.notes %><% } %>
          </div>
          <div class="mono" style="font-size:0.7rem; max-height:60px; overflow:hidden; color:#718096; margin-top:0.25rem;">
            <%= h.content.substring(0, 150) %><%= h.content.length > 150 ? '...' : '' %>
          </div>
        </div>
      <% } %>
    <% } %>
  </div>
</div>
