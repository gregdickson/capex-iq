<div style="max-width: 360px; margin: 4rem auto;">
  <div class="card" style="text-align: center;">
    <h1 style="margin-bottom: 0.5rem;">CapexIQ</h1>
    <p class="text-muted" style="margin-bottom: 1.5rem;">Enter your API key to continue</p>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/login">
      <div class="field">
        <input type="password" name="key" placeholder="API key" required autofocus
               style="text-align: center; font-size: 1rem; padding: 0.75rem;" />
      </div>
      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem; font-size: 1rem;">
        Log in
      </button>
    </form>
  </div>
</div>
