{
  "name": "capexiq",
  "version": "1.0.0",
  "description": "CapexIQ lead qualification and outreach pipeline",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && cp -r src/db/migrations dist/db/migrations",
    "start:api": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "start:cron": "node dist/cron.js",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "bullmq": "^5.76.2",
    "csv-parse": "^6.2.1",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "ioredis": "^5.10.1",
    "multer": "^2.1.1",
    "openai": "^6.34.0",
    "pg": "^8.20.0",
    "serpapi": "^2.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-ejs-layouts": "^2.5.4",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
